# Cadena de conexión PostgreSQL (desarrollo)
DATABASE_URL=postgresql://promohunt:promohunt@localhost:5432/descuentos_juegos

# BD exclusiva para tests (docker compose up -d db-test)
TEST_DATABASE_URL=postgresql://promohunt:promohunt@localhost:5433/descuentos_juegos_test

# JWT — genera una clave con:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-al-menos-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Entorno: development | production
ENVIRONMENT=development

# CORS (frontend Vite)
CORS_ORIGINS=http://localhost:5173

# SMTP (Mailpit en desarrollo — UI en http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@promohunt.local
