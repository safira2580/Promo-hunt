# Copiar a .env.prod y completar. NUNCA subir .env.prod al repositorio.
POSTGRES_USER=promohunt
POSTGRES_PASSWORD=CAMBIAR_por_una_contrasena_larga_y_aleatoria
POSTGRES_DB=descuentos_juegos

# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_por_64_hex_aleatorios

# Origen público del sitio (solo necesario si frontend y API están en dominios distintos)
CORS_ORIGINS=http://localhost
WEB_PORT=80

# Ajuste de rendimiento
WEB_CONCURRENCY=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
BCRYPT_ROUNDS=12
